<UserControl x:Class="WindowsDynamicBar.UI.TelemetryDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             UseLayoutRounding="True">

    <!-- btop / Hyprland style boxed panel: thin green rounded border with a title tag on the
         top edge; a main graph column (single graph + process list) and a stats column. -->
    <Grid>
        <Border x:Name="Frame" Width="470" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12"
                Background="#FF000000">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- graph column: compact graph with the process list below -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="40" CornerRadius="4" ClipToBounds="True">
                        <local:DotMatrixGraph x:Name="Graph" />
                    </Border>

                    <StackPanel x:Name="ProcsHost" Grid.Row="1" Margin="0,4,0,0" />
                </Grid>

                <!-- stats: two balanced sub-columns so the panel stays short like the island -->
                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="StatsCol0" />
                    <StackPanel x:Name="StatsCol1" Grid.Column="1" Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- title tag:  ┤cpu├┤42%├┤peak 71%├  -->
        <Border x:Name="TitleTag" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,28,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="11" />
        </Border>
    </Grid>
</UserControl>
