<UserControl x:Class="WindowsDynamicBar.UI.TelemetryDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             UseLayoutRounding="True">

    <!-- btop / Hyprland style boxed panel: thin green rounded border with a title tag on the
         top edge; a main graph column (single graph + process list) and a stats column. -->
    <Grid>
        <Border x:Name="Frame" Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Margin="0,16,16,16"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12"
                Background="#FF000000">
            <Grid Margin="12,14,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <!-- graph column: single main graph + process list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" MinHeight="30">
                        <local:DotMatrixGraph x:Name="Graph" />
                    </Border>

                    <StackPanel x:Name="ProcsHost" Grid.Row="1" Margin="0,5,0,0" />
                </Grid>

                <StackPanel x:Name="StatsCol" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- title tag:  ┤cpu├┤42%├┤peak 71%├  -->
        <Border x:Name="TitleTag" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,28,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="11" />
        </Border>
    </Grid>
</UserControl>
