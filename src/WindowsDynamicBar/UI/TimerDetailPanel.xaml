<UserControl x:Class="WindowsDynamicBar.UI.TimerDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             UseLayoutRounding="True">

    <!-- Same boxed card as the other panels: thin green border, black fill, title tag on the edge. -->
    <Grid>
        <Border x:Name="Frame" Width="494" Height="138" HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12" Background="#FF000000">
            <Grid Margin="16,14,13,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- big dot-matrix countdown (idle clock font, scaled) + status -->
                <StackPanel VerticalAlignment="Center">
                    <local:DotMatrixClock x:Name="Countdown" ReduceMotion="True">
                        <local:DotMatrixClock.LayoutTransform>
                            <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                        </local:DotMatrixClock.LayoutTransform>
                    </local:DotMatrixClock>
                    <local:DotProgressBar x:Name="Progress" Height="5" Margin="0,8,0,0" />
                    <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" Foreground="#9AA088" />
                </StackPanel>

                <!-- presets, custom duration, start / stop -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <UniformGrid x:Name="Presets" Columns="4" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CustomBorder" CornerRadius="4" Background="#FF101410" BorderBrush="#334A5A3E" BorderThickness="1" Height="24"
                                Cursor="IBeam" MouseLeftButtonDown="OnCustomBorderMouseDown">
                            <Grid>
                                <TextBlock x:Name="CustomHint" Text="custom: 90s, 12 min, 1h" Margin="7,0,0,0"
                                           VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="10" Foreground="#5F6656" IsHitTestVisible="False" />
                                <TextBox x:Name="CustomBox" Background="Transparent" BorderThickness="0" Margin="4,0"
                                         VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Courier New"
                                         FontSize="10.5" Foreground="#E8E8DC" CaretBrush="#8AB478"
                                         TextChanged="OnCustomChanged" PreviewKeyDown="OnCustomKeyDown"
                                         PreviewMouseDown="OnCustomBoxPreviewMouseDown"
                                         GotFocus="OnCustomBoxGotFocus" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Border x:Name="PauseBtn" Margin="0,0,6,0" CornerRadius="4" Height="24"
                                    Padding="10,0" BorderThickness="1" BorderBrush="#E8B04B" Cursor="Hand"
                                    Background="#FF000000" Visibility="Collapsed" MouseLeftButtonUp="OnPauseClick">
                                <TextBlock x:Name="PauseText" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                           Foreground="#E8B04B" Text="pause" />
                            </Border>
                            <Border x:Name="StartStop" CornerRadius="4" Height="24"
                                    Padding="12,0" BorderThickness="1" BorderBrush="#8AB478" Cursor="Hand"
                                    Background="#FF000000" MouseLeftButtonUp="OnStartStopClick">
                                <TextBlock x:Name="StartStopText" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                           Foreground="#8AB478" Text="start" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Margin="0,5,0,0" FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" Foreground="#D98A5B" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- title tag:  ┤timer├┤running├ -->
        <Border x:Name="TitleTag" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="29,0,0,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11.5" />
        </Border>
    </Grid>
</UserControl>
