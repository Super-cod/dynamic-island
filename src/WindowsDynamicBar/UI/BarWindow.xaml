<Window x:Class="WindowsDynamicBar.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:WindowsDynamicBar.UI.Media"
        xmlns:local="clr-namespace:WindowsDynamicBar.UI"
        Title="Windows Dynamic Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        ShowActivated="False"
        Focusable="True"
        MinWidth="40" MinHeight="40"
        Loaded="OnLoaded"
        Closed="OnClosed"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>

        <DropShadowEffect x:Key="WdbThumbShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="Black" />

        <!-- Minimal working Slider template (Track = PART_Track so value/drag/click-to-point all work).
             Visual fill is drawn by an external named Border updated from code-behind. -->
        <ControlTemplate x:Key="WdbSliderTemplate" TargetType="Slider">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"
                                      IsTabStop="False" Opacity="0" Background="Transparent" BorderThickness="0" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"
                                      IsTabStop="False" Opacity="0" Background="Transparent" BorderThickness="0" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Focusable="False">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Ellipse Width="13" Height="13" Fill="White"
                                             Effect="{StaticResource WdbThumbShadow}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Round icon button (media transport etc.) -->
        <Style x:Key="WdbIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo" Fill="{DynamicResource WdbDimBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource WdbTrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WdbPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WdbAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Typography ============ -->
        <Style x:Key="WdbTitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbSubText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbBigText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <!-- Window root: transparent canvas. The island is a single morphing shape inside one
         continuous hover region; the panel is part of the island so there is no gap. -->
    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="True">

        <!-- ================= ISLAND (single hover region: pill + icons + panel) ================= -->
        <Grid x:Name="IslandRegion" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
              MouseEnter="OnIslandMouseEnter" MouseLeave="OnIslandMouseLeave">

            <!-- ================= THE ONE SHAPE THAT MORPHS ================= -->
            <Border x:Name="Pill"
                    Margin="40,6,40,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    CornerRadius="26"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WdbHairlineBrush}"
                    Background="#FF000000"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="OnPillMouseDown"
                    MouseLeftButtonUp="OnPillMouseUp"
                    MouseMove="OnPillMouseMove"
                    PreviewMouseWheel="OnPillMouseWheel"
                    Cursor="Hand">

            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.55" Direction="270" />
            </Border.Effect>

            <Grid x:Name="PillGrid">

                <!-- ============ FAINT ALBUM RADIAL GLOW (behind left side) ============ -->
                <Border x:Name="AlbumRadialGlow" Panel.ZIndex="0" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Width="240" CornerRadius="36,0,0,36" IsHitTestVisible="False" Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush Center="0.1,0.5" GradientOrigin="0.1,0.5" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop x:Name="AlbumRadialGlowStop" Color="#00000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============ ACCENT GLOW (volume / brightness HUD) ============ -->
                <Border x:Name="VolumeHudGlow" Panel.ZIndex="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.08,0.5" Center="0.08,0.5"
                                             RadiusX="0.9" RadiusY="1.6">
                            <GradientStop x:Name="VolumeHudGlowStop" Color="#00000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.7" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============ COLLAPSED CONTENT (mini row) ============ -->
                <Grid x:Name="CollapsedPanel" VerticalAlignment="Center" Margin="48,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CollapsedTitle" Grid.Column="0" Style="{StaticResource WdbTitleText}"
                               Text="Dynamic" />
                    <TextBlock x:Name="CollapsedValue" Grid.Column="1" Style="{StaticResource WdbSubText}"
                               Margin="8,0,0,0" Foreground="{DynamicResource WdbAccentBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="2" Margin="12,0,2,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CollapsedClock" FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WdbAccentBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="CollapsedDate" FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9" Foreground="{DynamicResource WdbTextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <!-- ============ EVENT-BUS CONTENT (media / volume / timer cards) ============ -->
                <StackPanel x:Name="ExpandedHost" Orientation="Vertical"
                            Margin="16,13,16,14" Visibility="Collapsed" Opacity="0">

                    <!-- header row -->
                    <Grid x:Name="HeaderRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeaderIconBg" Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource WdbDimBrush}" Margin="0,0,11,0" VerticalAlignment="Top">
                            <Grid>
                                <Image x:Name="HeaderArt" Stretch="UniformToFill" Visibility="Collapsed" />
                                <TextBlock x:Name="HeaderGlyph" Style="{StaticResource WdbGlyph}"
                                           Text="&#x25CF;" FontSize="15" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderText" Style="{StaticResource WdbTitleText}"
                                       FontSize="14.5" Text="" />
                            <TextBlock x:Name="HeaderSub" Style="{StaticResource WdbSubText}"
                                       Text="" Margin="0,1,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="HeaderValue" Grid.Column="2" Style="{StaticResource WdbBigText}"
                                   FontSize="21" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="Collapsed" />
                    </Grid>

                    <!-- progress line (media / download / timer) -->
                    <StackPanel x:Name="ProgressRow" Margin="0,11,0,0" Visibility="Collapsed">
                        <Grid x:Name="ProgressTrack" Height="14" VerticalAlignment="Center">
                            <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="{DynamicResource WdbTrackBrush}" />
                            <Border x:Name="ProgressFill" Height="5" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="{DynamicResource WdbAccentBrush}" />
                            <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Value="0"
                                    IsMoveToPointEnabled="True" Cursor="Hand"
                                    ValueChanged="OnProgressSliderChanged"
                                    PreviewMouseLeftButtonUp="OnProgressSliderReleased"
                                    Template="{StaticResource WdbSliderTemplate}" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <TextBlock x:Name="PositionText" Style="{StaticResource WdbSubText}"
                                       FontSize="10.5" HorizontalAlignment="Left" Text="0:00" />
                            <TextBlock x:Name="DurationText" Style="{StaticResource WdbSubText}"
                                       FontSize="10.5" HorizontalAlignment="Right" Text="0:00" />
                        </Grid>
                    </StackPanel>

                    <!-- transport controls (media) -->
                    <StackPanel x:Name="TransportRow" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,9,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource WdbIconButton}" Click="OnPrevClick" ToolTip="Previous">
                            <TextBlock Style="{StaticResource WdbGlyph}" Text="&#xE892;" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource WdbIconButton}"
                                Width="40" Height="40" Margin="7,0" Click="OnPlayPauseClick" ToolTip="Play / Pause">
                            <TextBlock x:Name="PlayGlyph" Style="{StaticResource WdbGlyph}"
                                       FontSize="17" Text="&#xE768;" />
                        </Button>
                        <Button Style="{StaticResource WdbIconButton}" Click="OnNextClick" ToolTip="Next">
                            <TextBlock Style="{StaticResource WdbGlyph}" Text="&#xE893;" />
                        </Button>
                    </StackPanel>

                    <!-- volume/brightness HUD (icon | label + dot-matrix bar | value) -->
                    <Grid x:Name="VolumeHudRow" Visibility="Collapsed" MinWidth="330">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolumeHudIcon" Grid.Column="0" Style="{StaticResource WdbGlyph}"
                                   FontSize="24" Margin="2,0,16,0" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Foreground="{DynamicResource WdbTextBrush}">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="VolumeHudIconScale" ScaleX="1" ScaleY="1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="VolumeHudLabel" Style="{StaticResource WdbSubText}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"
                                       Foreground="{DynamicResource WdbTextMutedBrush}" />
                            <local:VolumeLevelBar x:Name="VolumeHudBar" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBlock x:Name="VolumeHudValue" Grid.Column="2" Style="{StaticResource WdbBigText}"
                                   FontSize="24" Margin="16,0,2,0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- signal bars (network) -->
                    <StackPanel x:Name="BarsRow" Orientation="Horizontal" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <Border x:Name="Bar1" Width="26" Height="6" CornerRadius="3" Background="{DynamicResource WdbDimBrush}" Margin="0,0,5,0" />
                        <Border x:Name="Bar2" Width="26" Height="6" CornerRadius="3" Background="{DynamicResource WdbDimBrush}" Margin="0,0,5,0" />
                        <Border x:Name="Bar3" Width="26" Height="6" CornerRadius="3" Background="{DynamicResource WdbDimBrush}" Margin="0,0,5,0" />
                        <Border x:Name="Bar4" Width="26" Height="6" CornerRadius="3" Background="{DynamicResource WdbDimBrush}" />
                    </StackPanel>

                    <!-- system monitor rows -->
                    <StackPanel x:Name="SysMonRow" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource WdbSubText}" Text="CPU" />
                            <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WdbDimBrush}" />
                                <Border x:Name="CpuFill" Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                        Width="0" Background="{DynamicResource WdbAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="CpuValue" Grid.Column="2" Style="{StaticResource WdbSubText}"
                                       HorizontalAlignment="Right" Text="0%" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource WdbSubText}" Text="GPU" />
                            <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WdbDimBrush}" />
                                <Border x:Name="GpuFill" Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                        Width="0" Background="{DynamicResource WdbAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="GpuValue" Grid.Column="2" Style="{StaticResource WdbSubText}"
                                       HorizontalAlignment="Right" Text="0%" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource WdbSubText}" Text="RAM" />
                            <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WdbDimBrush}" />
                                <Border x:Name="RamFill" Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                        Width="0" Background="{DynamicResource WdbAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="RamValue" Grid.Column="2" Style="{StaticResource WdbSubText}"
                                       HorizontalAlignment="Right" Text="0%" />
                        </Grid>
                    </StackPanel>

                    <!-- action buttons row (timer / focus / stopwatch control) -->
                    <StackPanel x:Name="ActionsRow" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="ActionPrimary" Style="{StaticResource WdbPrimaryButton}"
                                Content="Pause" Click="OnActionPrimary" Margin="0,0,8,0" />
                        <Button x:Name="ActionSecondary" Style="{StaticResource WdbPrimaryButton}"
                                Content="Cancel" Click="OnActionSecondary" Background="{DynamicResource WdbTrackBrush}" />
                    </StackPanel>

                    <!-- generic footer (device names, file names…) -->
                    <TextBlock x:Name="FooterText" Style="{StaticResource WdbSubText}"
                               Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- ============ ISLAND EXPANDED (.full: music + icon grid, left:158, 22px right padding) ============ -->
                <Grid x:Name="IslandExpandedHost" Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="158,0,22,0" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="242" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="MediaInfoStack" Grid.Column="0" Width="242" VerticalAlignment="Center">
                        <!-- 1. TITLE: 18 px, semibold, one line, clipped, soft fade on the right edge (last 6%) -->
                        <Grid x:Name="TitleContainer" Height="24" ClipToBounds="True">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.94" />
                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <TextBlock x:Name="HoverTitle" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center" Text="" TextTrimming="None">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="HoverTitleTransform" X="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- 2. ARTIST ROW: artist name 13 px in dim gray (#8e8e96), then small chip button -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="HoverArtist" FontSize="13" Foreground="#8E8E96"
                                       TextTrimming="CharacterEllipsis" MaxWidth="165" VerticalAlignment="Center" Text="" />
                            <Button x:Name="SourceChip" Click="OnSourceChipClick" Cursor="Hand" Margin="8,0,0,0"
                                    Background="#1AFFFFFF" BorderThickness="0" Padding="8,2" Height="20" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ChipBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ChipBorder" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock x:Name="SourceChipText" FontSize="11" Foreground="#FFFFFFFF" Text="Music ▾" />
                            </Button>
                        </StackPanel>

                        <!-- 3. LYRIC LINE: 12 px, one line, ellipsis, color = accent mixed 55% white. Height reserved: 16 px -->
                        <Grid x:Name="LyricContainer" Height="16" Margin="0,2,0,0" ClipToBounds="True">
                            <TextBlock x:Name="LyricText" FontSize="12" Foreground="#D0E2FF"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="" Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LyricTransform" Y="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- 4. PROGRESS ROW (6 px below): elapsed time, bar, -remaining -->
                        <Grid x:Name="HoverProgressContainer" Height="16" Margin="0,6,0,0" Background="Transparent"
                              PreviewMouseLeftButtonDown="OnHoverProgressMouseDown"
                              PreviewMouseMove="OnHoverProgressMouseMove"
                              PreviewMouseLeftButtonUp="OnHoverProgressMouseUp"
                              MouseEnter="OnHoverProgressMouseEnter"
                              MouseLeave="OnHoverProgressMouseLeave">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="HoverTimeElapsed" Grid.Column="0" Text="0:00"
                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                       Foreground="#8E8E96" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <Grid x:Name="HoverProgressBarTrack" Grid.Column="1" Height="16" Background="Transparent" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center" />
                                <Border x:Name="HoverProgressFill" Height="4" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0" Background="#FFFFFFFF" VerticalAlignment="Center" />
                                <Ellipse x:Name="HoverProgressKnob" Width="10" Height="10" Fill="#FFFFFFFF"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"
                                         Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="HoverProgressTooltip" Background="#F018181B" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="0,-22,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="HoverProgressTooltipText" Text="0:00"
                                               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" Foreground="#FFFFFFFF" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="HoverTimeRemaining" Grid.Column="2" Text="-0:00"
                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                       Foreground="#8E8E96" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>

                        <!-- 5. CONTROLS ROW: round 34 px buttons: prev, play/pause, next, volume + slider, eq -->
                        <Grid Margin="0,8,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource WdbIconButton}" Width="34" Height="34"
                                        Click="OnPrevClick" ToolTip="Previous">
                                    <TextBlock Style="{StaticResource WdbGlyph}" FontSize="13.5" Text="&#xE892;" />
                                </Button>
                                <Button x:Name="HoverPlayButton" Style="{StaticResource WdbIconButton}"
                                        Width="34" Height="34" Margin="6,0,0,0"
                                        Click="OnPlayPauseClick" ToolTip="Play / Pause">
                                    <TextBlock x:Name="HoverPlayGlyph" Style="{StaticResource WdbGlyph}"
                                               FontSize="13.5" Text="&#xE769;" />
                                </Button>
                                <Button Style="{StaticResource WdbIconButton}" Width="34" Height="34"
                                        Margin="6,0,0,0" Click="OnNextClick" ToolTip="Next">
                                    <TextBlock Style="{StaticResource WdbGlyph}" FontSize="13.5" Text="&#xE893;" />
                                </Button>

                                <StackPanel x:Name="VolumeControlGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            MouseEnter="OnVolumeGroupMouseEnter"
                                            MouseLeave="OnVolumeGroupMouseLeave">
                                    <Button x:Name="HoverSpeakerButton" Style="{StaticResource WdbIconButton}"
                                            Width="34" Height="34" Click="OnHoverSpeakerClick" ToolTip="Mute / Unmute">
                                        <TextBlock x:Name="HoverSpeakerGlyph" Style="{StaticResource WdbGlyph}"
                                                   FontSize="13.5" Text="&#xE767;" />
                                    </Button>
                                    <Border x:Name="HoverVolumeSliderHost" Width="0" Height="24" ClipToBounds="True"
                                            VerticalAlignment="Center" Opacity="0">
                                        <Slider x:Name="HoverVolumeSlider" Minimum="0" Maximum="1" Width="70"
                                                Margin="4,0,0,0" VerticalAlignment="Center"
                                                ValueChanged="OnHoverVolumeSliderChanged"
                                                Focusable="True" />
                                    </Border>
                                </StackPanel>

                                <local:Equalizer x:Name="HoverEq" Width="100" Height="24"
                                                 VerticalAlignment="Center" Margin="6,0,0,0"
                                                 Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Ring grid: 3 cols x 2 rows of 46px round buttons, 10px gaps, 20px gap from middle column -->
                    <local:TelemetryIconRow x:Name="IconRow" Grid.Column="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="20,0,0,0" />
                </Grid>

                <!-- ============ THE (single) MORPHING DISC + 30px SOURCE BADGE ============ -->
                <Grid x:Name="OrbContainer" Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="10.5,0,0,0">
                    <Border x:Name="OrbHost" Width="27" Height="27" CornerRadius="13.5"
                            Background="{DynamicResource WdbDimBrush}"
                            MouseLeftButtonUp="OnDiscClicked" Cursor="Hand" ToolTip="Bring app to front"
                            PreviewMouseWheel="OnDiscMouseWheel">
                        <Grid>
                            <media:MediaDisc x:Name="OrbDisc" Diameter="{Binding ActualWidth, ElementName=OrbHost}"
                                             Visibility="Collapsed" />
                            <Image x:Name="OrbArt" Stretch="UniformToFill" Visibility="Collapsed" />
                            <TextBlock x:Name="OrbGlyph" Style="{StaticResource WdbGlyph}"
                                       FontSize="12" Text="&#x25CF;" Foreground="#FF0A84FF" />
                        </Grid>
                    </Border>

                    <!-- 30 px round source badge at bottom-right of disc (-2px right, 2px bottom) -->
                    <Border x:Name="SourceBadge" Width="30" Height="30" CornerRadius="15"
                            Background="#FF18181B" BorderBrush="#FF000000" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-2,-2" Visibility="Collapsed" IsHitTestVisible="False">
                        <Image x:Name="SourceBadgeIcon" Width="18" Height="18" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- ============ SMART WARNING STRIP (RAM / CPU / Battery) ============ -->
                <Border x:Name="WarningStrip" Height="40" VerticalAlignment="Bottom"
                        Background="#00000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Visibility="Collapsed" Opacity="0">
                    <Grid>
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38E5484D" Offset="0.0" />
                                    <GradientStop Color="#00E5484D" Offset="0.75" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="16,0,16,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WarningStripText" Grid.Column="0" FontSize="12"
                                       Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Text="" />
                            <Button x:Name="WarningReviewBtn" Grid.Column="1" Click="OnWarningReviewClick"
                                    Content="Review" FontSize="11" Foreground="#FFFFFFFF"
                                    Background="#33FFFFFF" BorderThickness="0" Padding="10,3" Height="22"
                                    VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="11" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="WarningCloseBtn" Grid.Column="2" Click="OnWarningCloseClick"
                                    Content="✕" FontSize="11" Foreground="#8E8E96"
                                    Background="Transparent" BorderThickness="0" Width="22" Height="22"
                                    VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Hand" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ RIGHT DETAIL PANEL (boxed card, inset 16px) ============ -->
                <local:TelemetryDetailPanel x:Name="DetailPanelComponent"
                                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="494"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                <local:NetDetailPanel x:Name="NetPanelComponent"
                                      Panel.ZIndex="1" HorizontalAlignment="Right" Width="494"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                <local:MirrorDetailPanel x:Name="MirrorPanelComponent"
                                         Panel.ZIndex="1" HorizontalAlignment="Right" Width="230"
                                         Margin="0,0,16,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                <local:WeatherDetailPanel x:Name="WeatherPanelComponent"
                                          Panel.ZIndex="1" HorizontalAlignment="Right" Width="494"
                                          Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                <!-- ============ SEARCH BAR HOST ============ -->
                <Grid x:Name="SearchHost" Panel.ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Input Bar (58px high, 22px side padding, 10px gaps) -->
                    <Grid Grid.Row="0" Margin="22,0,22,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dimmed magnifier icon 20px -->
                        <TextBlock x:Name="SearchMagnifier" Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource WdbTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Active App Tag Chip (pill shaped, 22px icon, semibold 14px text) -->
                        <Border x:Name="SearchAppTag" Grid.Column="1" Height="32" CornerRadius="16"
                                Background="#26FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"
                                Visibility="Collapsed" Padding="6,2,12,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#33FFFFFF" Margin="0,0,8,0">
                                    <Grid>
                                        <Image x:Name="SearchAppTagIcon" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock x:Name="SearchAppTagLetter" FontSize="12" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="SearchAppTagName" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WdbTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Text Input + Ghost Completion + Placeholder -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <!-- Ghost Completion (faint gray text) -->
                            <TextBlock x:Name="SearchGhostText" FontSize="20"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="#44FFFFFF" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Margin="2,0,0,0" />

                            <!-- Real Input TextBox -->
                            <TextBox x:Name="SearchInput" FontSize="20"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     Foreground="{DynamicResource WdbTextBrush}"
                                     Background="Transparent" BorderThickness="0"
                                     CaretBrush="{DynamicResource WdbAccentBrush}"
                                     VerticalAlignment="Center" TextChanged="OnSearchInputChanged"
                                     PreviewKeyDown="OnSearchInputPreviewKeyDown" />

                            <!-- Placeholder -->
                            <TextBlock x:Name="SearchPlaceholder" FontSize="20"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="#38FFFFFF" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Margin="2,0,0,0"
                                       Text="Search apps, files, commands..." />
                        </Grid>

                        <!-- Right hint -->
                        <TextBlock x:Name="SearchRightHint" Grid.Column="3" Text="esc close"
                                   FontFamily="Consolas, Cascadia Code, monospace" FontSize="11"
                                   Foreground="{DynamicResource WdbTextMutedBrush}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Results Section (Divider + Scrollable Results, max 330px high, ONLY AFTER TYPING) -->
                    <Grid x:Name="SearchResultsSection" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 1px divider -->
                        <Border Grid.Row="0" Height="1" Background="{DynamicResource WdbHairlineBrush}" Margin="16,0,16,0" />

                        <!-- Scrollable list -->
                        <ScrollViewer x:Name="SearchResultsScroll" Grid.Row="1" MaxHeight="330"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="10,6,10,10" Focusable="False">
                            <StackPanel x:Name="SearchResultsList" Orientation="Vertical" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>
        </Border>

        </Grid>
    </Grid>
</Window>
