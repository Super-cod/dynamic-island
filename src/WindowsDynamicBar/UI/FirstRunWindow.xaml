<Window x:Class="WindowsDynamicBar.UI.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Bar — Welcome"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF141417"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="FeatureCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Flat buttons: the default template turns hovered buttons light blue (#BEE6FD), which made
             the white "Next" label unreadable on hover. -->
        <ControlTemplate x:Key="FlatButton" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButton}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,22">

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="20" Background="#1AFFFFFF"
                    VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock Text="&#x25CF;" FontSize="18" Foreground="#FF0A84FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Windows Dynamic Bar"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="StepCaption" Text="Dynamic-Island-style interactive overlay for your desktop"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12" Foreground="#B3FFFFFF" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 4 progress dots -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#FF0A84FF" Margin="0,0,6,0" />
            <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#28FFFFFF" Margin="0,0,6,0" />
            <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#28FFFFFF" Margin="0,0,6,0" />
            <Ellipse x:Name="Dot4" Width="7" Height="7" Fill="#28FFFFFF" />
        </StackPanel>

        <!-- ============ Step 1: Welcome ============ -->
        <StackPanel x:Name="Step1" Margin="0,18,0,0">
            <TextBlock FontSize="13.5" Foreground="#EEEEEE" TextWrapping="Wrap"
                       FontFamily="Segoe UI Variable Text, Segoe UI" LineHeight="20"
                       Text="A Dynamic-Island-style overlay for Windows that brings subtle notifications, system status, and productivity cards to the top of your screen." />

            <Border Background="#0FFFFFFF" CornerRadius="8" Padding="14,12" Margin="0,16,0,0"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Key capabilities:" FontWeight="SemiBold" FontSize="12.5" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="&#x2022; Live media player, lyrics, volume &amp; brightness HUD" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,4" />
                    <TextBlock Text="&#x2022; System monitor (CPU, GPU, RAM, battery &amp; network)" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,4" />
                    <TextBlock Text="&#x2022; Search launcher, window switcher, countdown timers and clipboard history" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,4" />
                    <TextBlock Text="&#x2022; Local-only &amp; privacy-first: no telemetry, no tracking, no data leaves your PC" FontSize="12" Foreground="#B0B0B0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ Step 2: Features ============ -->
        <StackPanel x:Name="Step2" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Choose which features you want to enable (all on by default):"
                       FontSize="13" Foreground="#DDDDDD" Margin="0,0,0,10" />
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <CheckBox x:Name="FeatMedia" Content="Music &amp; Media controls (now playing, album art, lyrics)" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatIdle" Content="Idle dashboard (clock, ambient greeting, focus sessions)" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatNotifications" Content="Notifications (incoming toast notifications in island)" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatVolumeHud" Content="Volume &amp; brightness HUD" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatSearch" Content="Search bar &amp; window switcher" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatMirror" Content="Camera mirror ring" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatSpeedTest" Content="Network speed test" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatClipboard" Content="Clipboard history (last 10 items, pin &amp; paste)" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatToggles" Content="Quick toggles (Wi-Fi, Bluetooth, DND, dark mode)" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                    <CheckBox x:Name="FeatTimers" Content="Countdown timer &amp; stopwatch" Style="{StaticResource FeatureCheck}" IsChecked="True" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- ============ Step 3: Permissions ============ -->
        <StackPanel x:Name="Step3" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="System permissions for your selected features:"
                       FontSize="13" Foreground="#DDDDDD" Margin="0,0,0,12" />

            <!-- Notifications permission row -->
            <Border x:Name="PermNotifCard" Background="#0FFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                        <TextBlock Text="Windows requires listener permission to show incoming notifications" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                        <TextBlock x:Name="PermNotifStatus" Text="Status: Checking..." FontSize="11" Foreground="#0A84FF" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="PermNotifButton" Grid.Column="1" Content="Enable" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0" Click="OnRequestNotifPermission" />
                </Grid>
            </Border>

            <!-- Camera permission row -->
            <Border x:Name="PermCameraCard" Background="#0FFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Camera (Mirror)" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                        <TextBlock Text="Windows asks only when the mirror is first used, not now" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                        <TextBlock Text="Status: On demand (only active when mirror open)" FontSize="11" Foreground="#30D158" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Settings" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0" Click="OnOpenCameraSettings" />
                </Grid>
            </Border>

            <!-- Startup with Windows switch row -->
            <Border Background="#0FFFFFFF" CornerRadius="8" Padding="12,10"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                        <TextBlock Text="Start quietly in the background when signing into Windows" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                        <TextBlock x:Name="PermStartupStatus" Text="Status: Enabled" FontSize="11" Foreground="#30D158" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="PermStartupToggle" Grid.Column="1" Content="Toggle" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0" Click="OnToggleStartup" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ Step 4: Shortcuts ============ -->
        <StackPanel x:Name="Step4" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Global keyboard shortcuts (press anywhere to trigger):"
                       FontSize="13" Foreground="#DDDDDD" Margin="0,0,0,12" />

            <!-- Search shortcut -->
            <Border Background="#0FFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Island Search &amp; Window Switcher" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                        <TextBlock Text="Opens search launcher with Tab commands and w window switcher" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBox x:Name="ShortcutSearchBox" Grid.Column="1" Text="Ctrl+Space" Width="90" Height="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#20000000" Foreground="White" BorderBrush="#40FFFFFF" Margin="8,0" />
                    <Button Grid.Column="2" Content="Try it" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Click="OnTrySearch" />
                </Grid>
            </Border>

            <!-- Clipboard shortcut -->
            <Border Background="#0FFFFFFF" CornerRadius="8" Padding="12,10"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clipboard History" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                        <TextBlock Text="Opens island directly on recent copied texts, links, images" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBox x:Name="ShortcutClipBox" Grid.Column="1" Text="Ctrl+Alt+V" Width="90" Height="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#20000000" Foreground="White" BorderBrush="#40FFFFFF" Margin="8,0" />
                    <Button Grid.Column="2" Content="Try it" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Click="OnTryClipboard" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Footer buttons -->
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Text="Step 1 of 4" FontSize="11"
                       Foreground="#80FFFFFF" VerticalAlignment="Center" />
            <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="OnBack"
                    Visibility="Collapsed"
                    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                    Foreground="#CCFFFFFF" Background="#18FFFFFF"
                    BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                    Template="{StaticResource FlatButton}" />
            <Button x:Name="NextButton" Grid.Column="2" Content="Next" Click="OnNext"
                    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
                    FontWeight="SemiBold" Foreground="White" Background="#FF0A84FF"
                    BorderThickness="0" Padding="18,8" Cursor="Hand"
                    Template="{StaticResource FlatButton}" />
        </Grid>

    </StackPanel>
</Window>
