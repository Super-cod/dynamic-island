<UserControl x:Class="WindowsDynamicBar.UI.MirrorDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             UseLayoutRounding="True" Width="230" Height="138">

    <!-- Privacy-first mirror panel. Just the camera frame - no settings column. Opening the
         panel never starts the camera: clicking the Mirror icon toggles it on and off. The
         right border hugs the frame; the frame keeps its exact size. -->
    <Grid>
        <Border x:Name="Frame" Width="230" Height="138" HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12"
                Background="#FF000000">
            <Border x:Name="PreviewHost" Width="208" Height="117" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,10,11,11"
                    Background="#FF111111" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Preview" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="-1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>

                    <local:ScanlineOverlay x:Name="Scanlines" IsHitTestVisible="False" />

                    <TextBlock x:Name="Placeholder"
                               FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                               Foreground="#FF9AA088" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Click the Mirror icon" />
                </Grid>
            </Border>
        </Border>

        <!-- title tag:  ┤mirror├┤STATUS├┤private├  -->
        <Border x:Name="TitleTag" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="29,0,0,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="11.5" />
        </Border>
    </Grid>
</UserControl>