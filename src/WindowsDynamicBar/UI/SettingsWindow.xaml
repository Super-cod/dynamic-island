<Window x:Class="WindowsDynamicBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Bar — Settings"
        Width="600" Height="720"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF101013"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">

    <DockPanel>
        <!-- header -->
        <Grid DockPanel.Dock="Top" Height="58" Background="#FF141417">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="Settings" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Windows Dynamic Bar" FontSize="11" Foreground="#80FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <Button Content="Reset defaults" Click="OnResetDefaults" Margin="0,0,8,0"
                        Padding="12,6" FontSize="11.5" Foreground="#CCFFFFFF" Background="#18FFFFFF"
                        BorderThickness="0" Cursor="Hand" />
                <Button Content="Done" Click="OnDone" Padding="18,6" FontSize="12"
                        FontWeight="SemiBold" Foreground="White" Background="#FF0A84FF"
                        BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- footer -->
        <Grid DockPanel.Dock="Bottom" Height="34" Background="#FF141417">
            <TextBlock x:Name="StatusText" Text="Settings save automatically"
                       VerticalAlignment="Center" Margin="20,0,0,0"
                       FontSize="10.5" Foreground="#66FFFFFF" />
        </Grid>

        <!-- content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,16">
            <StackPanel x:Name="Root" Margin="20,0,20,0" />
        </ScrollViewer>
    </DockPanel>
</Window>
