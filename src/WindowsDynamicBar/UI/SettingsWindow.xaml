<Window x:Class="WindowsDynamicBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Bar — Settings"
        Width="720" Height="640"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF101013"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ sidebar ============ -->
        <Border Grid.Column="0" Background="#FF141417">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                    <TextBlock Text="Dynamic Bar" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Settings" FontSize="10.5" Foreground="#70FFFFFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel x:Name="NavPanel" Margin="8,6,8,12" />
            </DockPanel>
        </Border>

        <!-- ============ main column ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- page header -->
            <Grid Grid.Row="0" Background="#FF141417">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="PageTitle" Text="General" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="15" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="PageSub" Text="" FontSize="10.5" Foreground="#70FFFFFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Button Content="Reset defaults" Click="OnResetDefaults" Margin="0,0,8,0"
                            Padding="12,6" FontSize="11.5" Foreground="#CCFFFFFF" Background="#18FFFFFF"
                            BorderThickness="0" Cursor="Hand" />
                    <Button Content="Done" Click="OnDone" Padding="18,6" FontSize="12"
                            FontWeight="SemiBold" Foreground="White" Background="#FF0A84FF"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- page content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,0,16">
                <StackPanel x:Name="Root" Margin="20,0,20,0" />
            </ScrollViewer>

            <!-- footer -->
            <Grid Grid.Row="2" Background="#FF141417">
                <TextBlock x:Name="StatusText" Text="Settings save automatically"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           FontSize="10.5" Foreground="#66FFFFFF" />
            </Grid>
        </Grid>
    </Grid>
</Window>
