<UserControl x:Class="WindowsDynamicBar.UI.ClipboardDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <!-- Same boxed card as the other panels: thin green border, black fill, title tag on the edge. -->
    <Grid>
        <Border x:Name="Frame" Width="494" Height="138" HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12" Background="#FF000000">
            <Grid Margin="11,12,11,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- search (filters as you type) -->
                <Border Grid.Row="0" CornerRadius="4" Background="#FF101410" BorderBrush="#334A5A3E" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="SearchHint" Text="search" Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5" Foreground="#5F6656"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Margin="4,0,4,0"
                                 VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                                 Foreground="#E8E8DC" CaretBrush="#8AB478" SelectionBrush="#558AB478"
                                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                    </Grid>
                </Border>

                <!-- history, newest first; 28 px rows -->
                <ScrollViewer x:Name="ListScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False">
                    <StackPanel x:Name="Rows" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5" Foreground="#9AA088"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- title tag:  ┤clip├┤4/10├ -->
        <Border x:Name="TitleTag" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="29,0,0,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11.5" />
        </Border>

        <!-- title-row actions on the top edge -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,0,24,0">
            <Border x:Name="PauseButton" Background="#FF000000" Padding="5,0" Cursor="Hand" MouseLeftButtonUp="OnPauseClick">
                <TextBlock x:Name="PauseText" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" Foreground="#8AB478" />
            </Border>
            <Border x:Name="ClearButton" Background="#FF000000" Padding="5,0" Cursor="Hand" MouseLeftButtonUp="OnClearClick">
                <TextBlock Text="clear all" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" Foreground="#D98A5B" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
