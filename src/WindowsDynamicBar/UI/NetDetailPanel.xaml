<UserControl x:Class="WindowsDynamicBar.UI.NetDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             UseLayoutRounding="True">

    <!-- btop / Hyprland style boxed panel for live network activity + speed test. Compact so it
         fits the fixed island height: mirrored graph, live rate, latency tiles and a stats column. -->
    <Grid>
        <Border x:Name="Frame" Width="494" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0"
                BorderBrush="#8AB478" BorderThickness="1" CornerRadius="12"
                Background="#FF000000">
            <Grid Margin="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>

                <!-- live graph / rates / latency / quality -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border CornerRadius="4" ClipToBounds="True">
                            <local:NetMirrorGraph x:Name="NetGraph" />
                        </Border>
                        <TextBlock Text="&#x2193; down" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="#4FC3D9" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="&#x2191; up" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="#C48FE0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblSpeed" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="#CFD3C4" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LblLink" Grid.Column="1" Margin="10,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="#9AA088" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <UniformGrid x:Name="TilesHost" Grid.Row="2" Columns="4" Margin="0,5,0,0" />

                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QualityText" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="#CFD3C4" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TodayText" Grid.Column="1" Margin="10,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="#9AA088" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <!-- speed-test controls + result stats -->
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Speed test" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                               Foreground="#E6E0A8" />
                    <Button x:Name="TestButton" Click="OnTestClick"
                            FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#8AB478"
                            Background="Transparent" BorderBrush="#B38AB478" BorderThickness="1"
                            Padding="0,2" Margin="0,3,0,3" Cursor="Hand"
                            HorizontalContentAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2E8AB478" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#8AB478" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel x:Name="StatsRows" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- title tag:  ┤net├┤STATUS├┤42%├  -->
        <Border x:Name="TitleTag" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="29,0,0,0" Background="#FF000000" Padding="6,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="11.5" />
        </Border>
    </Grid>
</UserControl>
