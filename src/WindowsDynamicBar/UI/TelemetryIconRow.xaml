<UserControl x:Class="WindowsDynamicBar.UI.TelemetryIconRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True">

    <!-- Pages of 3x2 46px ring cells (built in code from the page layout). The pages slide inside a
         clip that ends just right of the third ring; the pager dots sit in the free strip after it. -->
    <Grid Width="175" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="PagesClip" Width="164" HorizontalAlignment="Left" ClipToBounds="True">
            <WrapPanel x:Name="Page0" Width="175" HorizontalAlignment="Left">
                <WrapPanel.RenderTransform><TranslateTransform x:Name="Page0Shift" /></WrapPanel.RenderTransform>
            </WrapPanel>
            <WrapPanel x:Name="Page1" Width="175" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                <WrapPanel.RenderTransform><TranslateTransform x:Name="Page1Shift" X="175" /></WrapPanel.RenderTransform>
            </WrapPanel>
        </Grid>

        <!-- pager: one 6px dot per page; active = white, others = white 25% -->
        <StackPanel x:Name="Pager" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"
                    Visibility="Collapsed" />
    </Grid>

</UserControl>
