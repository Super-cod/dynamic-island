<UserControl x:Class="WindowsDynamicBar.UI.TelemetryIconRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsDynamicBar.UI"
             Background="Transparent"
             UseLayoutRounding="True">

    <!-- 3x2 grid of 44px circles: CPU/GPU/RAM live gauges + Disk/Net/Temp placeholders (disabled). -->
    <WrapPanel Width="162" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Grid x:Name="CpuCell" Width="44" Height="44" Margin="0,0,10,10" Background="Transparent" Cursor="Hand">
            <local:RingGauge x:Name="CpuRing" Thickness="2.5" />
            <Border x:Name="CpuBorder" Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource WdbDimBrush}"
                    BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="CPU" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                               Foreground="{DynamicResource WdbTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CpuPct" Text="…" FontFamily="Cascadia Mono, Consolas"
                               FontSize="8" Foreground="{DynamicResource WdbTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="GpuCell" Width="44" Height="44" Margin="0,0,10,10" Background="Transparent" Cursor="Hand">
            <local:RingGauge x:Name="GpuRing" Thickness="2.5" />
            <Border x:Name="GpuBorder" Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource WdbDimBrush}"
                    BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="GPU" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                               Foreground="{DynamicResource WdbTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GpuPct" Text="…" FontFamily="Cascadia Mono, Consolas"
                               FontSize="8" Foreground="{DynamicResource WdbTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="RamCell" Width="44" Height="44" Margin="0,0,10,10" Background="Transparent" Cursor="Hand">
            <local:RingGauge x:Name="RamRing" Thickness="2.5" />
            <Border x:Name="RamBorder" Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource WdbDimBrush}"
                    BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="RAM" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                               Foreground="{DynamicResource WdbTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RamPct" Text="…" FontFamily="Cascadia Mono, Consolas"
                               FontSize="8" Foreground="{DynamicResource WdbTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,10,10"
                Background="{DynamicResource WdbDimBrush}"
                BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1"
                Opacity="0.35" ToolTip="Not set up yet">
            <TextBlock Text="Disk" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                       Foreground="{DynamicResource WdbTextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,10,10"
                Background="{DynamicResource WdbDimBrush}"
                BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1"
                Opacity="0.35" ToolTip="Not set up yet">
            <TextBlock Text="Net" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                       Foreground="{DynamicResource WdbTextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,10,0"
                Background="{DynamicResource WdbDimBrush}"
                BorderBrush="{DynamicResource WdbHairlineBrush}" BorderThickness="1"
                Opacity="0.35" ToolTip="Not set up yet">
            <TextBlock Text="Temp" FontFamily="Cascadia Mono, Consolas" FontSize="8.5"
                       Foreground="{DynamicResource WdbTextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

    </WrapPanel>

</UserControl>
