<Application x:Class="WindowsDynamicBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <Application.Resources>

        <!-- ============ Palette: Dark (default) ============ -->
        <Color x:Key="WdbBgColor">#F0141417</Color>
        <Color x:Key="WdbBgElevated">#FA1D1D21</Color>
        <Color x:Key="WdbAccentColor">#FF0A84FF</Color>
        <Color x:Key="WdbTextColor">#FFFFFFFF</Color>
        <Color x:Key="WdbTextMuted">#B3FFFFFF</Color>
        <Color x:Key="WdbHairline">#28FFFFFF</Color>

        <SolidColorBrush x:Key="WdbBgBrush" Color="{StaticResource WdbBgColor}" />
        <SolidColorBrush x:Key="WdbBgElevatedBrush" Color="{StaticResource WdbBgElevated}" />
        <SolidColorBrush x:Key="WdbAccentBrush" Color="{StaticResource WdbAccentColor}" />
        <SolidColorBrush x:Key="WdbTextBrush" Color="{StaticResource WdbTextColor}" />
        <SolidColorBrush x:Key="WdbTextMutedBrush" Color="{StaticResource WdbTextMuted}" />
        <SolidColorBrush x:Key="WdbHairlineBrush" Color="{StaticResource WdbHairline}" />
        <!-- Themed dim/track fills (recolored by ThemeService for Light/Translucent) -->
        <SolidColorBrush x:Key="WdbDimBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="WdbTrackBrush" Color="#28FFFFFF" />

        <!-- ============ Typography ============ -->
        <Style x:Key="WdbTitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbSubText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbBigText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WdbGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource WdbTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ============ Round icon button (media transport etc.) ============ -->
        <Style x:Key="WdbIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo" Fill="#14FFFFFF" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Halo" Property="Fill" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WdbPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WdbAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Progress bar ============ -->
        <Style x:Key="WdbProgressBar" TargetType="Grid">
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ Widget title row ============ -->
        <Style x:Key="WdbWidgetRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

    </Application.Resources>
</Application>
